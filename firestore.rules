rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function: Check if the user is signed in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: Check if the user is accessing their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Protect the root user document
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Protect all subcollections within the user document
      // (stories, moments, timeline, knowledge, sessions)
      match /{subcollection}/{document=**} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // Default deny for everything else (Crucial for security)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
